[Unit]
Description=voxl-open-vins-server
SourcePath=/usr/local/bin/voxl-open-vins-server
# TODO should not require waiting for camera and imu servers, pipes auto-connect when available
After=voxl-camera-server.service
After=voxl-imu-server.service
# if using default modalai products
#Requires=voxl-camera-server.service
Requires=voxl-imu-server.service


[Service]
User=root
Type=simple
Restart=on-failure
RestartSec=3s
# kill if we have a memory leak to protect the rest of the system
MemoryMax=4G
PIDFile=/run/voxl-open-vins-server.pid
# why is this here can we get rid of it?!!?
ExecStartPre=/bin/bash -c 'if [[ ! -f /tmp/_vins_powerup ]]; then /bin/sleep 12 && touch /tmp/_vins_powerup; fi'
ExecStart=/usr/local/bin/voxl-open-vins-server

[Install]
WantedBy=multi-user.target


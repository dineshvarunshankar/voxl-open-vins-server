# SIGMA_AB=(3.0000e-02)

# what do i want to happen...
# basically, try changing the covariance only in steps of 5
# then raw noise only in steps of 5
# then both

# gonna start with feature shit cranked up, then play with it from there
SIGMA_W=(1.6968e-04 1.6968e-04 1.6968e-04 1.6968e-04 1.6968e-04 1.6968e-04 1.6968e-04 1.6968e-04 1.6968e-04 0.000000271 0.000001357 0.000006787 0.000033936 1.6968e-04 0.0008484 0.004242 0.02121 0.10605 0.000000271 0.000001357 0.000006787 0.000033936 1.6968e-04 0.0008484 0.004242 0.02121 0.10605)

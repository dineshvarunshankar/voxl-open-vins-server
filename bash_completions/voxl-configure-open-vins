_voxl-configure-open-vins(){

    local OPTS=('disable help factory_enable enable starling_v2 starling_v2.5 starling_v2.7 px4 fpv manual prep')

    COMPREPLY=()
	if [ "$COMP_CWORD" -eq 1 ]; then
		COMPREPLY=( $(compgen -W '${OPTS}' -- ${COMP_WORDS[COMP_CWORD]}) )
		return 0
	fi
}

complete -F _voxl-configure-open-vins voxl-configure-open-vins
